# Apache configuration (XAMPP / WAMP / Laragon / most shared hosts)

# Custom 404 page (adjust path if the site is not in /website-template)
ErrorDocument 404 /website-template/404.php

# Don't list folder contents
Options -Indexes

# Block direct web access to config, includes and stored messages
RedirectMatch 403 ^/website-template/(config|includes|storage)/

# Basic security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
</IfModule>
